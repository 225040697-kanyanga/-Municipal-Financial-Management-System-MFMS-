int main(void)
{
    int number;
    double decimal;
    char name[100];
    char email[100];
    char phone[30];

    printf("========================================\n");
    printf("       VALIDATION FUNCTION TEST\n");
    printf("========================================\n\n");

    
    number = getValidInt(
        "Enter employee ID (1-9999): ",
        1,
        9999
    );

    printf("Valid ID: %d\n\n", number);

    
    decimal = getValidDouble(
        "Enter salary (0-1000000): ",
        0.0,
        1000000.0
    );

    printf("Valid salary: %.2f\n\n", decimal);

    
    getValidString(
        "Enter employee name: ",
        name,
        sizeof(name)
    );

    printf("Valid name: %s\n\n", name);

   
    while (1)
    {
        getValidString(
            "Enter email: ",
            email,
            sizeof(email)
        );

        if (isValidEmail(email))
        {
            printf("Valid email: %s\n\n", email);
            break;
        }

        printf("Invalid email address. Please try again.\n");
    }

    
    while (1)
    {
        getValidString(
            "Enter phone number: ",
            phone,
            sizeof(phone)
        );

        if (isValidPhone(phone))
        {
            printf("Valid phone number: %s\n\n", phone);
            break;
        }

        printf("Invalid phone number. Please try again.\n");
    }

    printf("========================================\n");
    printf("All validation tests completed.\n");
    printf("========================================\n");

    return 0;
}
