int getValidInt(const char *prompt, int min, int max);
double getValidDouble(const char *prompt, double min, double max);
void getValidString(const char *prompt, char *output, int size);
int isValidEmail(const char *email);
int isValidPhone(const char *phone);

int getValidInt(const char *prompt, int min, int max)
{
    char input[100];
    char *endPtr;
    long value;

    while (1)
    {
        printf("%s", prompt);

        if (fgets(input, sizeof(input), stdin) == NULL)
        {
            printf("Error reading input.\n");
            continue;
        }

        
        input[strcspn(input, "\n")] = '\0';

        
        if (strlen(input) == 0)
        {
            printf("Input cannot be empty.\n");
            continue;
        }

        
        value = strtol(input, &endPtr, 10);

        
        while (isspace((unsigned char)*endPtr))
        {
            endPtr++;
        }

       
        if (*endPtr != '\0')
        {
            printf("Invalid whole number. Please try again.\n");
            continue;
        }

        
        if (value < min || value > max)
        {
            printf("Please enter a number between %d and %d.\n",
                   min, max);
            continue;
        }

        return (int)value;
    }
}



double getValidDouble(const char *prompt, double min, double max)
{
    char input[100];
    char *endPtr;
    double value;

    while (1)
    {
        printf("%s", prompt);

        if (fgets(input, sizeof(input), stdin) == NULL)
        {
            printf("Error reading input.\n");
            continue;
        }

        
        input[strcspn(input, "\n")] = '\0';

        
        if (strlen(input) == 0)
        {
            printf("Input cannot be empty.\n");
            continue;
        }

        
        value = strtod(input, &endPtr);

        
        while (isspace((unsigned char)*endPtr))
        {
            endPtr++;
        }

        
        if (*endPtr != '\0')
        {
            printf("Invalid decimal number. Please try again.\n");
            continue;
        }

        
        if (value < min || value > max)
        {
            printf("Please enter a value between %.2f and %.2f.\n",
                   min, max);
            continue;
        }

        return value;
    }
}



void getValidString(const char *prompt, char *output, int size)
{
    int onlySpaces;

    while (1)
    {
        printf("%s", prompt);

        if (fgets(output, size, stdin) == NULL)
        {
            printf("Error reading input.\n");
            continue;
        }

        
        output[strcspn(output, "\n")] = '\0';

         
        if (strlen(output) == 0)
        {
            printf("Input cannot be empty.\n");
            continue;
        }

        
        onlySpaces = 1;

        for (int i = 0; output[i] != '\0'; i++)
        {
            if (!isspace((unsigned char)output[i]))
            {
                onlySpaces = 0;
                break;
            }
        }

        if (onlySpaces)
        {
            printf("Input cannot contain only spaces.\n");
            continue;
        }

        return;
    }
}



int isValidEmail(const char *email)
{
    const char *at;
    const char *dot;

    if (email == NULL)
    {
        return 0;
    }

   
    if (strlen(email) < 5)
    {
        return 0;
    }

    
    for (int i = 0; email[i] != '\0'; i++)
    {
        if (isspace((unsigned char)email[i]))
        {
            return 0;
        }
    }

    
    at = strchr(email, '@');

    if (at == NULL)
    {
        return 0;
    }

    
    if (at == email)
    {
        return 0;
    }

    
    if (strchr(at + 1, '@') != NULL)
    {
        return 0;
    }

    
    dot = strchr(at + 1, '.');

    if (dot == NULL)
    {
        return 0;
    }

    
    if (dot == at + 1)
    {
        return 0;
    }

    
    if (*(dot + 1) == '\0')
    {
        return 0;
    }

    return 1;
}



